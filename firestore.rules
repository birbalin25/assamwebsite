rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Public content: anyone can read, only authenticated users can write
    match /events/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /performances/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /media/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /albums/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Donations: authenticated read/write only
    match /donations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Contact messages: anyone can create, only authenticated can read/delete
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, delete: if isAuthenticated();
    }

    // Site config: public read, authenticated write
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
